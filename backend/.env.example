# --- Server ---
PORT=8787
# Comma-separated origins allowed to call the API. The extension's origin is
# chrome-extension://<id>; during dev you can allow all with *.
CORS_ORIGIN=*

# --- Supabase ---
# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side ONLY — bypasses RLS; never ship to the extension).
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for screenshots (created by supabase/storage.sql).
SUPABASE_BUCKET=captures

# --- Google Gemini (vision) ---
# Free-tier key from https://aistudio.google.com/apikey — the key lives ONLY
# here on the backend. Never in the extension.
GEMINI_API_KEY=
# Vision model. gemini-flash-latest tracks Google's current recommended free-tier
# flash model, avoiding hardcoding to a version that later gets deprecated.
VISION_MODEL=gemini-flash-latest

# --- Vision worker ---
# How often the worker polls for pending captures (ms).
WORKER_POLL_MS=3000
# How many pending captures to process per tick.
WORKER_BATCH=4
