{
  "name": "visual-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Consent-based Chrome extension that visually monitors browser activity with Claude vision",
  "workspaces": [
    "extension",
    "backend",
    "dashboard"
  ],
  "scripts": {
    "build:extension": "npm run build --workspace extension",
    "build:backend": "npm run build --workspace backend",
    "build:dashboard": "npm run build --workspace dashboard",
    "dev:backend": "npm run dev --workspace backend",
    "dev:dashboard": "npm run dev --workspace dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "license": "MIT",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
